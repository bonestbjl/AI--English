{
  "name": "real-scene-english",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "build:frontend": "node scripts/build-frontend.mjs",
    "generate:theme-covers": "node scripts/generate-theme-cover-thumbnails.mjs",
    "validate:theme-covers": "node scripts/validate-theme-covers.mjs",
    "serve:performance": "node scripts/serve-static-performance.mjs",
    "test:visual": "node scripts/visual-regression.mjs compare --baseline=tests/visual-regression/baselines/293ae600 --current=tmp/visual-regression/current --report=tmp/visual-regression/report",
    "generate:theme-resource-packs": "node scripts/generate-theme-resource-packs.mjs",
    "validate:theme-resource-packs": "node scripts/validate-theme-resource-packs.mjs",
    "optimize:deploy-cn-images": "node scripts/optimize-deploy-cn-images.mjs",
    "prepare:deploy-cn": "npm run generate:theme-covers && npm run build:frontend && npm run optimize:deploy-cn-images && npm run generate:theme-resource-packs && npm run build:frontend"
  },
  "dependencies": {
    "alipay-sdk": "3.6.2",
    "tencentcloud-sdk-nodejs-sms": "4.1.240"
  },
  "devDependencies": {
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "3.4.17",
    "ws": "^8.21.0"
  }
}
